<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/global-styles.css">
    <link rel="stylesheet" href="/styles/dashboard.css">
     <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <title>Edit User - Air Hockey Online</title>
</head>
<style>
    .profile .user-details {
        padding: 40px 10px 20px;
        margin-top: 0px;
        background: linear-gradient(45deg, #483556, #292733);
        background: #201f26;
        border: none;
    }

    .profile .top-boxes {
        margin-left: 0px;
    }

    .profile-meta {
        padding-bottom: 60px;
    }

    .profile .key-value-box {
        height: 55px;
        min-width: 300px;
    }

    .profile span.box-key {
        font-weight: 700;
    }
</style>

<body>

    <div class="dashboard-layout d-flex gap-20 p-20 justify-center">


        <div class="dashboard-content w-60per md-w-80per loading p-20 d-flex direction-col gap-30  pos-relative">
            <div class="profile">
                <div class="reward-header text-center p-10">
                    <h3 class="heading-md text-uppercase divider-heading">Profile</h3>
                    <p class="text-sm text-gray">Player profile and game stats!</p>
                </div>

                <div class="user-details p-10 px-20" bis_skin_checked="1">
                    <div class="profile-meta text-center">
                        <div class="profile-img">
                            <img class="rounded-10" src="<%= profile.avatar %>" alt="Avatar" width="200">
                        </div>
                        <h2 class="heading-lg mb-0">
                            <%= profile.displayName %>
                        </h2>
                        <span class="d-block text-gray">@<%= profile.name %></span>
                    </div>
                    <div class="user-stats justify-start" bis_skin_checked="1">
                        <div class="key-value-box top-boxes " bis_skin_checked="1">
                            <span class="box-key ">Email:</span>
                            <span class="box-value font-bold text-sm" data-email="">
                                <%= profile.email %>
                            </span>
                        </div>
                        <div class="key-value-box top-boxes " bis_skin_checked="1">
                            <span class="box-key ">Coins:</span>
                            <span class="box-value font-bold text-sm" data-coins="">
                                <%= profile.coins %>
                            </span>
                        </div>
                        <div class="key-value-box top-boxes " bis_skin_checked="1">
                            <span class="box-key ">Registered:</span>
                            <span class="box-value font-bold text-sm" data-registered-date="">
                                <%= new Date(profile.createdAt).toDateString() %>
                            </span>
                        </div>
                        <div class="key-value-box top-boxes " bis_skin_checked="1">
                            <span class="box-key ">Game Played:</span>
                            <span class="box-value font-bold text-sm" data-games-played="">
                                <%= stats.totalGames %>
                            </span>
                        </div>
                        <div class="key-value-box w-40per" bis_skin_checked="1">
                            <span class="box-key ">Winning Streak:</span>
                            <span class="box-value font-bold text-sm" data-win-streak="">
                                <%= stats.winStreak %>
                            </span>
                        </div>
                        <div class="key-value-box" bis_skin_checked="1">
                            <span class="box-key ">Loses:</span>
                            <span class="box-value font-bold text-sm" data-lose="">
                                <%= stats.totalLosses %>
                            </span>
                        </div>
                        <div class="key-value-box" bis_skin_checked="1">
                            <span class="box-key ">Win:</span>
                            <span class="box-value font-bold text-sm" data-win="">
                                <%= stats.totalWins %>
                            </span>
                        </div>
                        <div class="key-value-box" bis_skin_checked="1">
                            <span class="box-key ">Win%:</span>
                            <span class="box-value font-bold text-sm" data-win-per="">
                                <%= stats.winPercentage %>%
                            </span>
                        </div>
                        <div class="key-value-box" bis_skin_checked="1">
                            <span class="box-key ">Total Army:</span>
                            <span class="box-value font-bold text-sm" data-last-game="">
                                <%= stats.totalFriends %>
                            </span>
                        </div>

                        <div class="key-value-box" bis_skin_checked="1">
                            <span class="box-key ">Account Status:</span>
                            <span class="box-value font-bold text-sm" data-last-game="">
                                <%= user.accountStatus %>
                            </span>
                        </div>
                        <% if (user.accountStatus == 'active') { %>
                            <button data-id=" <%= user._id %>" id="btn-block">Block Account</button>
                            <% } else { %>
                                <button data-id=" <%= user._id %>" id="btn-unblock">UNBlock Account</button>
                                <% } %>

                    </div>
                </div>



            </div>

        </div>


    </div>

    <%- include('./partials/footer') %>

        <script src="/js/edit-user.js"></script>
</body>

</html>