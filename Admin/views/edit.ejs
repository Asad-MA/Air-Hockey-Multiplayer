<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User</title>
</head>
<body>
    <h2>Edit User</h2>
    <form action="/edit/<%= user._id %>?_method=PUT" method="POST">
        <label>Name:</label>
        <input type="text" name="name" value="<%= user.name %>" required>
        <label>Email:</label>
        <input type="email" name="email" value="<%= user.email %>" required>
        <label>isVerified:</label>
        <input type="text" name="role" value="<%= user.isVerified %>" required>
        <label>accountStatus:</label>
        <input type="text" name="role" value="<%= user.accountStatus %>" required>
        <button type="submit">Update</button>
    </form>
    <a href="/">Back</a>
</body>
</html>
