                                <span class="ui-table-col d-flex gap-10 justify-between align-center w-full-available">
                                    <div class="match-palyer text-left d-flex gap-10" bis_skin_checked="1">
                                        <span class="user-avatar-sm box-img box-rounded w-50 h-50 bg-gray">
                                            <img src="https://res.cloudinary.com/de6upiddr/image/upload/v1746959878/cartoon-man-wearing-vr-glasses_rbaihe.jpg"
