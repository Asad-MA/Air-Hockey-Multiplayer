<body>

    <div class="dashboard-layout p-20">
        <div class="reward-header text-center p-10" bis_skin_checked="1">
            <h3 class="heading-md text-uppercase divider-heading">Game Server Stats</h3>
            <p class="text-sm text-gray">Live performance and activity metrics!</p>
        </div>

        <div class="dashboard-content grid grid-cols-3 gap-4">
            <div class="gameserver-stats">
                <div class="dashboard-chart flex-grow">
                    <h3 class="heading-sm text-uppercase text-center p-10 text-gray">CPU Usage %</h3>
                    <div id="cpu-usage-chart" style="width:100%; height:400px;"></div>
                </div>

                <div class="dashboard-chart">
                    <h3 class="heading-sm text-uppercase text-center text-gray p-10">RAM Usage</h3>
                    <div id="memory-usage">

                    </div>
                </div>
            </div>

            <div class="service-monitoring d-flex gap-20 flex-wrap justify-between full-width">


                <div class="dashboard-widget d-flex direction-col align-center flex-grow service-loading" id="game-service">
                    <div class="service-icon">
                        <img src="/img/game.png" alt="Server Icon" class="">
                    </div>
                    <div class="service-details">
                        <h3 class="heading-sm text-uppercase text-gray text-center">Game Cloud Service</h3>
                        <div class="d-flex g-20 align-center flex-wrap justify-between service-stats">
                            <p class="text-sm text-gray">Status: <span id="web-server-status"
                                    class="text-gray">Loading...</span></p>
                            <p class="text-sm text-gray">Uptime: <span id="web-server-uptime"
                                    class="text-gray">Loading...</span></p>
                        </div>
                    </div>


                </div>

                <div class="dashboard-widget d-flex direction-col align-center flex-grow service-loading" id="web-service">
                    <div class="service-icon">
                        <img src="/img/web.png" alt="Server Icon" class="">
                    </div>
                    <div class="service-details">
                        <h3 class="heading-md text-uppercase text-center">Web Service</h3>
                        <div class="d-flex g-20 align-center flex-wrap justify-between service-stats">
                            <p class="text-sm text-gray">Status: <span id="web-server-status"
                                    class="text-gray">Loading...</span></p>
                            <p class="text-sm text-gray">Uptime: <span id="web-server-uptime"
                                    class="text-gray">Loading...</span></p>
                        </div>
                    </div>


                </div>

                <div class="dashboard-widget d-flex direction-col align-center flex-grow service-loading" id="gateway-service">
                    <div class="service-icon">
                        <img src="/img/bell.png" alt="Server Icon" class="">
                    </div>
                    <div class="service-details">
                        <h3 class="heading-md text-uppercase text-center">Gateway Service</h3>
                        <div class="d-flex g-20 align-center flex-wrap justify-between service-stats">
                            <p class="text-sm text-gray">Status: <span id="web-server-status"
                                    class="text-gray">Loading...</span></p>
                            <p class="text-sm text-gray">Uptime: <span id="web-server-uptime"
                                    class="text-gray">Loading...</span></p>
                        </div>

                    </div>


                </div>

                <div class="dashboard-card flex-grow full-width">
                    <div class="Recent-chats-widget flex-fill ui-block">

                        <div
                            class="widget-header glow-border-top glow-gold bg-grad-default text-center p-10 rounded-10">
                            <h3 class="widget-title my-0">Active Rooms</h3>
                        </div>
                        <table id="rooms-table" class="display" style="width:100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Room Name</th>
                                    <th>Room ID</th>
                                    <th>Clients</th>
                                    <th>Max Clients</th>
                                    <th>Locked</th>
                                    <th>Private</th>
                                    <th>Unlisted</th>
                                    <th>Elapsed Time</th>
                                    <th>Created At</th>
                                    <th>Process ID</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>


                    </div>
                </div>

                <div class="reward-header text-center p-10 full-width flex-grow">
                    <h3 class="heading-md text-uppercase divider-heading">User Stats</h3>
                    <p class="text-sm text-gray">Manage users and view User & Game related stats!</p>
                </div>

                <div class="dashboard-card flex-grow">
                    <div class="Recent-chats-widget flex-fill ui-block">

                        <div
                            class="widget-header glow-border-top glow-gold bg-grad-default text-center p-10 rounded-10">
