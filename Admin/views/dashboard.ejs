                    </div>
                </div>

                <div class="dashboard-card flex-grow full-width">
                    <div class="Recent-chats-widget flex-fill ui-block">

                        <div
                            class="widget-header glow-border-top glow-gold bg-grad-default text-center p-10 rounded-10">
                            <h3 class="widget-title my-0">Registered Users</h3>
                        </div>

                        <table id="users-table" class="display" style="width:100%">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>User Name</th>
                                    <th>Display Name</th>
                                    <th>Email</th>
                                    <th>Coins</th>
                                    <th>Daily Streak</th>
                                    <th>Verified</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>


                    </div>
                </div>

                <div class="dashboard-card flex-grow">
                    <div class="Recent-chats-widget flex-fill ui-block">

                        <div
                            class="widget-header glow-border-top glow-gold bg-grad-default text-center p-10 rounded-10">
                            <h3 class="widget-title my-0">Game Settings</h3>
                        </div>
                        <div class="ui-table-default d-flex direction-col gap-5 py-10" id="top-players-table">
                            <form id="game-settings-form">

                                <label>
                                    Paddle Mass:
                                    <input type="range" name="paddleMass" min="0.5" max="5" step="0.1" value="1"
                                        oninput="paddleMassValue.innerText = this.value">
                                    <span id="paddleMassValue" class="text-sm text-gray">1</span>
                                </label>

                                <label>
                                    Paddle Max Speed:
                                    <input type="range" name="paddleMaxSpeed" min="100" max="1000" step="50" value="300"
                                        oninput="paddleSpeedValue.innerText = this.value">
                                    <span id="paddleSpeedValue" class="text-sm text-gray">300</span>
                                </label><br />

                                <label>
                                    Puck Mass:
                                    <input type="range" name="puckMass" min="0.1" max="2" step="0.1" value="0.5"
                                        oninput="puckMassValue.innerText = this.value">
                                    <span id="puckMassValue" class="text-sm text-gray">0.5</span>
                                </label><br />

                                <label>
                                    Puck Max Speed:
                                    <input type="range" name="puckMaxSpeed" min="100" max="1500" step="100" value="500"
                                        oninput="puckSpeedValue.innerText = this.value">
                                    <span id="puckSpeedValue" class="text-sm text-gray">500</span>
                                </label><br />

                                <label>
                                    Puck Friction:
                                    <input type="range" name="puckFriction" min="0" max="1" step="0.01" value="0.1"
                                        oninput="puckFrictionValue.innerText = this.value">
                                    <span id="puckFrictionValue" class="text-sm text-gray">0.1</span>
                                </label>

                                <label>
                                    Time Limit (mins):
                                    <input type="range" name="timeLimit" min="3" max="30" step="3" value="3"
                                        oninput="timeLimitValue.innerText = this.value + ' mins'">
                                    <span id="timeLimitValue" class="text-sm text-gray">3 mins</span>
                                </label>

                                <label>
                                    💰 Entry Fee (coins):
                                    <input type="range" name="entryFee" min="200" max="1000" step="200" value="200"
                                        oninput="entryFeeValue.innerText = this.value + ' coins'">
                                    <span id="entryFeeValue" class="text-sm text-gray">200 coins</span>
                                </label><br />

                                <label>
                                    🏆 Reward Multiplier:
                                    <input type="range" name="rewardMultiplier" min="2" max="6" step="2" value="2"
                                        oninput="rewardValue.innerText = this.value + 'x'">
                                    <span id="rewardValue" class="text-sm text-gray">2x</span>
                                </label><br />

                                <button type="submit">💾 Save Settings</button>
                            </form>

                        </div>

                    </div>
                </div>
