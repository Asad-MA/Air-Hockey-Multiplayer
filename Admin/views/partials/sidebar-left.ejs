<div class="d-flex direction-col gap-10 pt-30 mt-20">
    <a class="glow-border-top pos-relative  sidebar-item decoration-none" href="/social/profile/<%= user.name %>">
        <span class="d-flex gap-10 align-center">
            <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                <i class="fa-solid fa-user-secret"></i>
            </span>
            <span class="text-sm text-uppercase">Profile</span>
        </span>
    </a>

    <a class="glow-border-top pos-relative sidebar-item decoration-none" href="/social/friends">
        <span class="d-flex gap-10 align-center">
            <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                <i class="fa-solid fa-users"></i>
            </span>
            <span class="text-sm text-uppercase">Friends</span>
        </span>
    </a>

    <a class="glow-border-top pos-relative sidebar-item">
        <span class="d-flex gap-10 align-center">
            <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                <i class="fa-solid fa-gamepad"></i>
            </span>
            <span class="text-sm text-uppercase">Play Game</span>
        </span>
        <span class="pos-absolute sub-menu d-flex direction-col gap-10 p-10">
            <span class="d-flex gap-10 align-center sub-menu-item" data-play-online>
                <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                    <i class="fa-solid fa-globe"></i>
                </span>
                <span class="text-sm text-uppercase">Play Online</span>
            </span>
            <span class="d-flex gap-10 align-center sub-menu-item">
                <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                    <i class="fa-brands fa-google-play"></i>
                </span>
                <span class="text-sm text-uppercase">Practice Offline</span>
            </span>
        </span>
    </a>

    <a class="glow-border-top pos-relative sidebar-item">
        <span class="d-flex gap-10 align-center">
            <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                <i class="fa-solid fa-flag-checkered"></i>
            </span>
            <span class="text-sm text-uppercase">Game Requests</span>
        </span>
    </a>

    <a class="glow-border-top pos-relative sidebar-item decoration-none" href="/social/chat">
        <span class="d-flex gap-10 align-center">
            <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                <i class="fa-brands fa-rocketchat"></i>
            </span>
            <span class="text-sm text-uppercase">Chat</span>
        </span>
    </a>

    <a class="glow-border-top pos-relative sidebar-item">
        <span class="d-flex gap-10 align-center">
            <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                <i class="fa-solid fa-gear"></i>
            </span>
            <span class="text-sm text-uppercase">Settings</span>
        </span>
    </a>

    <a class="glow-border-top pos-relative sidebar-item">
        <span class="d-flex gap-10 align-center">
            <span class="glassy-box  shape-square text-center w-50 d-flex align-center justify-center">
                <i class="fa-solid fa-right-from-bracket"></i>
            </span>
            <span class="text-sm text-uppercase">Logout</span>
        </span>
    </a>
</div>