<!-- <base href="http://localhost:3001/"> -->
<base href="http://<%= baseUrl %>:3001/">
<header class="p-10 d-flex justify-between align-start">
    <div class="text-center w-20per pt-0 pos-relative">
        <a href="/" class="pos-absolute abs-full">
            <img width="220" src="./img/logo.png" alt="site-logo" srcset="">
        </a>
    </div>
    <div class="d-flex justify-end align-center gap-30">
        <button class="icon-btn ui-default-btn" data-play-online>
            <span class="btn-icon mr-5"><i class="fa-solid fa-play"></i></span>
            <span class="btn-text text-uppercase text-sm">Play Online</span>
        </button>
        <p class="text-sm"><span id="player-count" class="text-sm">0</span> <span class="text-success text-sm">Online</span></p>
        <span class="divider-vr h-20"></span>
        <div class="game-coins d-flex  align-center gap-10"><img width="20" src="https://res.cloudinary.com/de6upiddr/image/upload/v1749232473/ynmuaabas41jbjkmjdpg.png" alt="" srcset=""> 
            <span class="text-sm text-gray"><%- user.coins %></span></div>
         <span class="divider-vr h-20"></span>
        <span class="ui-icon-default" data-noti-opener><i class="fa-solid fa-bell"></i></span>
        <div id="top-notification" class="float-window noti-window hidden">
            <div class="placeholder mb-10">

                <div class="skeleton text short"></div>
                <div class="skeleton text"></div>
              </div>
              <div class="placeholder mb-10">
                
                <div class="skeleton text short"></div>
                <div class="skeleton text"></div>
              </div>
              <div class="placeholder mb-10">
                
                <div class="skeleton text short"></div>
                <div class="skeleton text"></div>
              </div>
        </div>
        <div class="overlay"></div>
        <div class="user-meta d-flex img-box align-center gap-10">
            <span class="text-sm text-gray"><%- user.displayName %></span>
            <span class="box-img box-rounded w-50 h-50 bg-gray overflow-hidden">
                <img src="<%- user.avatar %>" alt="" srcset="">
            </span>
        </div>
        
            <button class="text-uppercase text-sm"><a href="/logout" class="text-uppercase d-block fill-area">Logout</a></button>
        
    </div>
    <script src="./js/libs/jQuery.js"></script>
    <script src="./game-core/framework/server/colyseus.js"></script>
    <script src="https://kit.fontawesome.com/192402329c.js" crossorigin="anonymous"></script>
    <script type="module" src="./js/realtime-stream.js"></script>
    <script type="module" src="./js/common/global.js"  defer></script>
    <script defer type="module" src="./js/common/noti-connection.js"></script>
    <script defer type="module" src="./js/common/presistant-noti.js"></script>
    <script type="module" src="./js/rooms/lobbyroom.js"></script>
    <script type="module" src="./js/common/status.js"></script>
</header>
