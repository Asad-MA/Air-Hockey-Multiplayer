<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/global-styles.css">
    <link rel="stylesheet" href="/styles/dashboard.css">
    <title>Air Hockey Online</title>
</head>

<body>
    <%- include('../partials/header') %>

        <div class="dashboard-layout d-flex align-start gap-20 p-20">
            <div class="ui-sidebar sidebar-left w-20per ">
                <%- include('../partials/sidebar-left') %>
            </div>

            <div class="dashboard-content w-60per md-w-80per loading p-20 d-flex direction-col gap-30">
                <div class="top-banner d-flex gap-10">
                    <div class="user-details w-50per p-10 px-20">
                        <div class="user-meta d-flex gap-20">
                            <div class="user-avatar">
                                <img src="<%- user.avatar %>" alt="" srcset="">
                            </div>
                            <div class="user-metadata">
                                <h3 class="display-name my-0 text-uppercase"><%- user.displayName %></h3>
                                <div class="d-flex justify-between align-center">
                                    <span class="username text-sm">@<%- user.name %></span>
                                    <span class="avtivity text-sm">Last Active: 2days</span>
                                </div>
                                <div class="ui-divider grad-purple"></div>
                            </div>
                        </div>
                        <div class="user-stats justify-start">
                            <div class="key-value-box top-boxes ">
                                <span class="box-key text-sm">Game Played:</span>
                                <span class="box-value font-bold text-sm" data-games-played>90</span>
                            </div>
                            <div class="key-value-box w-40per">
                                <span class="box-key text-sm">Winning Streak:</span>
                                <span class="box-value font-bold text-sm" data-win-streak>90</span>
                            </div>
                            <div class="key-value-box">
                                <span class="box-key text-sm">Lose:</span>
                                <span class="box-value font-bold text-sm" data-lose>10</span>
                            </div>
                            <div class="key-value-box">
                                <span class="box-key text-sm">Win:</span>
                                <span class="box-value font-bold text-sm" data-win>48</span>
                            </div>
                            <div class="key-value-box">
                                <span class="box-key text-sm">Win%:</span>
                                <span class="box-value font-bold text-sm" data-win-per>90</span>
                            </div>
                            <div class="key-value-box">
                                <span class="box-key text-sm">Last Game:</span>
                                <span class="box-value font-bold text-sm" data-last-game>Lose</span>
                            </div>
                        </div>
                    </div>
                    <div class="w-50per rounded-10 bg-gray charts-wrap">

                    </div>
                </div>

                <!-- <div class="ui-charts">

                </div> -->
                <div class="daily-rewards">
                    <div class="reward-header text-center p-10">
                        <h3 class="heading-md text-uppercase divider-heading">Daily Rewards</h3>
                        <p class="text-sm text-gray">Claim your daily rewards and earn coins!</p>
                    </div>
                    <%- include('../partials/reward-list') %>
                </div>

                <div class="leaderboard-weekly">
                    <div class="reward-header text-center p-10">
                        <h3 class="heading-md text-uppercase divider-heading">Leader Boards</h3>
                        <p class="text-sm text-gray">Top 3 Players of the Week!</p>
                    </div>
                    <div id="top3-weekly" class="top3-players-grid d-flex gap-30 align-end">

                        <div class="top-player-box">
                            <div class="player-avatar">
                                <img src="https://res.cloudinary.com/de6upiddr/image/upload/v1746959884/cartoon-P._Geerya_z3y17b.jpg"
                                    alt="Player Avatar">
                            </div>
                            <div class="top-player-content">
                                <div class="player-meta">
                                    <h3 class="player-d-name heading-xs">FIghting Falcon</h3>
                                    <!-- <span class="player-u-name">@redflag</span> -->
                                </div>
                                <div class="ui-divider bg-dark-gray"></div>
                                <div class="player-b-stats d-flex gap-30 align-center">
                                    <div class="stat-block flex-grow d-flex justify-between align-center">
                                        <span class="stat-key text-sm text-gray">Last Played:</span>
                                        <span class="stat-value text-sm">Lose</span>
                                    </div>
                                    <div class="divider-vr"></div>
                                    <div class="stat-block flex-grow d-flex justify-between align-center">
                                        <span class="stat-key text-sm text-gray">Coin Earned</span>
                                        <span class="stat-value text-sm">1.39M</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="top-player-box">
                            <div class="player-avatar">
                                <img src="https://res.cloudinary.com/de6upiddr/image/upload/v1746959884/cartoon-P._Geerya_z3y17b.jpg"
                                    alt="Player Avatar">
                            </div>
                            <div class="top-player-content">
                                <div class="player-meta">
                                    <span class="text-gray text-sm mb-5 d-in-block"><i
                                            class="fa-solid fa-star rank-star-pink"></i> Top Ranked</span>
                                    <h3 class="player-d-name heading-xs">FIghting Falcon</h3>
                                    <!-- <span class="player-u-name">@redflag</span> -->
                                </div>
                                <div class="ui-divider bg-dark-gray"></div>
                                <div class="player-b-stats d-flex gap-30 align-center">
                                    <div class="stat-block flex-grow d-flex justify-between align-center">
                                        <span class="stat-key text-sm text-gray">Last Played:</span>
                                        <span class="stat-value text-sm">Lose</span>
                                    </div>
                                    <div class="divider-vr"></div>
                                    <div class="stat-block flex-grow d-flex justify-between align-center">
                                        <span class="stat-key text-sm text-gray">Coin Earned</span>
                                        <span class="stat-value text-sm">1.39M</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="top-player-box">
                            <div class="player-avatar">
                                <img src="https://res.cloudinary.com/de6upiddr/image/upload/v1746959884/cartoon-P._Geerya_z3y17b.jpg"
                                    alt="Player Avatar">
                            </div>
                            <div class="top-player-content">
                                <div class="player-meta">
                                    <h3 class="player-d-name heading-xs">FIghting Falcon</h3>
                                    <!-- <span class="player-u-name">@redflag</span> -->
                                </div>
                                <div class="ui-divider bg-dark-gray"></div>
                                <div class="player-b-stats d-flex gap-30 align-center">
                                    <div class="stat-block flex-grow d-flex justify-between align-center">
                                        <span class="stat-key text-sm text-gray">Last Played:</span>
                                        <span class="stat-value text-sm">Lose</span>
                                    </div>
                                    <div class="divider-vr"></div>
                                    <div class="stat-block flex-grow d-flex justify-between align-center">
                                        <span class="stat-key text-sm text-gray">Coin Earned</span>
                                        <span class="stat-value text-sm">1.39M</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="ui-divider bg-dark-gray"></div>
                <div class="user-widgets d-flex gap-20">
                    <div class="Recent-chats-widget flex-fill ui-block">

                        <div
                            class="widget-header glow-border-top glow-gold bg-grad-default text-center p-10 rounded-10">
                            <h3 class="widget-title my-0">Top Players</h3>
                        </div>
                        <div class="ui-table-default d-flex direction-col gap-5 py-10">
                            <div class="ui-table-row d-flex align-center gap-10">
                                <span class="ui-table-col text-sm">1</span>
                                <span class="ui-table-col d-flex gap-10 w-full-available">
                                    <span class="user-avatar-sm box-img box-rounded w-50 h-50 bg-gray">

                                    </span>
                                    <span class="user-detail-sm w-full-available">
                                        <h5 class="text-sm user-displayname my-0">Ali</h5>
                                        <div class="d-flex justify-between">
                                            <span class="user-name text-sm text-gray">@username</span>
                                            <span class="d-flex align-center text-sm gap-5 text-gray">1.5k <i
                                                    class="fa-solid fa-ring"></i></span>
                                        </div>

                                    </span>
                                </span>

                            </div>

                            <div class="ui-table-row d-flex align-center gap-10">
                                <span class="ui-table-col text-sm">2</span>
                                <span class="ui-table-col d-flex gap-10 w-full-available">
                                    <a href="#">
                                        <span class="user-avatar-sm box-img box-rounded w-50 h-50 bg-gray">

                                        </span>
                                    </a>
                                    <span class="user-detail-sm w-full-available">
                                        <h5 class="text-sm user-displayname my-0 text-size-sm">Ali</h5>
                                        <div class="d-flex justify-between">
                                            <span class="user-name text-sm text-gray">@username</span>
                                            <span class="d-flex align-center text-sm gap-5 text-gray">1.5k <i
                                                    class="fa-solid fa-ring"></i></span>
                                        </div>

                                    </span>
                                </span>

                            </div>

                            <div class="ui-table-row d-flex align-center gap-10">
                                <span class="ui-table-col text-sm">3</span>
                                <span class="ui-table-col d-flex gap-10 w-full-available">
                                    <span class="user-avatar-sm box-img box-rounded w-50 h-50 bg-gray">

                                    </span>
                                    <span class="user-detail-sm w-full-available">
                                        <h5 class="text-sm user-displayname my-0">Ali</h5>
                                        <div class="d-flex justify-between">
                                            <span class="user-name text-sm text-gray">@username</span>
                                            <span class="d-flex align-center text-sm gap-5 text-gray">1.5k <i
                                                    class="fa-solid fa-ring"></i></span>
                                        </div>

                                    </span>
                                </span>

                            </div>



                        </div>

                    </div>
                    <div class="active-friends-widget flex-fill ui-block">

                        <div
                            class="widget-header glow-border-top glow-gold bg-grad-default text-center p-10 rounded-10">
                            <h3 class="widget-title my-0">Active Friends</h3>
                        </div>
                        <div class="ui-table-default d-flex direction-col gap-5 py-10" id="active-friends-table">
                            <div class="ui-table-row d-flex align-center gap-10 flex-grow" data-row="empty">
                                <span class="ui-table-col text-sm text-center text-gray">
                                    No active Friends right now
                                </span>

                            </div>

                        


                        </div>

                    </div>
                    <div class="history-widget flex-fill ui-block">

                        <div
                            class="widget-header glow-border-top glow-gold bg-grad-default text-center p-10 rounded-10">
                            <h3 class="widget-title my-0">Matches History</h3>
                        </div>
                        <div class="ui-table-default d-flex direction-col gap-5 py-10 " id="match-history-table">
                            <div class="ui-table-row d-flex align-center gap-10">
                                <span class="ui-table-col text-sm">1</span>
                                <span class="ui-table-col d-flex gap-10 justify-between align-center w-full-available">
                                    <div class="match-palyer text-left d-flex gap-10">
                                        <span class="user-avatar-sm box-img box-rounded w-50 h-50 bg-gray">

                                        </span>
                                        <span class="user-detail-sm w-full-available">
                                            <h5 class="text-sm user-displayname my-0">Ali</h5>
                                            <div class="">
                                                <span class="user-name text-sm text-gray">Goals: 10</span>
                                            </div>

                                        </span>
                                    </div>
                                    <h3 class="history-verses heading-xs">VS</h3>
                                     <div class="match-palyer text-right d-flex gap-10 justify-end">
                                        
                                        <span class="user-detail-sm w-full-available">
                                            <h5 class="text-sm user-displayname my-0">Ali</h5>
                                            <div class="">
                                                <span class="user-name text-sm text-gray">Goals: 10</span>
                                            </div>

                                        </span>
                                        <span class="user-avatar-sm box-img box-rounded w-50 h-50 bg-gray">

                                        </span>
                                    </div>

                                </span>

                            </div>

                            <div class="ui-table-row d-flex align-center gap-10">
                                <span class="ui-table-col text-sm">2</span>
                                <span class="ui-table-col d-flex gap-10 w-full-available">
                                    <a href="#">
                                        <span class="user-avatar-sm box-img box-rounded w-50 h-50 bg-gray">

                                        </span>
                                    </a>
                                    <span class="user-detail-sm w-full-available">
                                        <h5 class="text-sm user-displayname my-0 text-size-sm">Ali</h5>
                                        <div class="d-flex justify-between">
                                            <span class="user-name text-sm text-gray">@username</span>
                                            <span class="d-flex align-center text-sm gap-5 text-gray">1.5k <i
                                                    class="fa-solid fa-ring"></i></span>
                                        </div>

                                    </span>
                                </span>

                            </div>

                            <div class="ui-table-row d-flex align-center gap-10">
                                <span class="ui-table-col text-sm">3</span>
                                <span class="ui-table-col d-flex gap-10 w-full-available">
                                    <span class="user-avatar-sm box-img box-rounded w-50 h-50 bg-gray">

                                    </span>
                                    <span class="user-detail-sm w-full-available">
                                        <h5 class="text-sm user-displayname my-0">Ali</h5>
                                        <div class="d-flex justify-between">
                                            <span class="user-name text-sm text-gray">@username</span>
                                            <span class="d-flex align-center text-sm gap-5 text-gray">1.5k <i
                                                    class="fa-solid fa-ring"></i></span>
                                        </div>

                                    </span>
                                </span>

                            </div>



                        </div>

                    </div>
                </div>
            </div>

            <!-- <div class="ui-sidebar sidebar-right w-20per md-hidden">
                <%- include('../partials/leaderboards') %>
            </div> -->
        </div>

        <%- include('../partials/footer') %>
            <script>
                window.sessionStorage.setItem('token', "<%- user.token %>");
            </script>




            <script type="module" src="./js/pages/dashboard.js"></script>
</body>

</html>