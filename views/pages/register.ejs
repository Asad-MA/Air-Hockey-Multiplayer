
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./styles/global-styles.css">
    <link rel="stylesheet" href="./styles/register.css">
    <script src="https://kit.fontawesome.com/192402329c.js" crossorigin="anonymous"></script>
    <title>Register - Air Hockey</title>
</head>
<body>
    <div class="site-main bg-default d-flex direction-col">
        <%- include('../partials/header-public') %>
        <main class="site-content fill-space d-flex direction-col justify-center align-center">
        <section class="form-container site-modal pos-relative overflow-hidden register-form">
            <div class="loader"></div>
            <form method="post">
                <h1 class="heading-lg text-center">Register</h1>
                <div class="divider mb-30 mt-20"></div>
                <div class="d-grid grid-col-2 gap-10">
                    <div class="width-5"><input type="text" name="username" id="" placeholder="Username"></div>
                    <div class="width-5"><input type="email" name="usermail" id="" placeholder="User Email"></div>
                    <div class="width-5"><input type="password" name="password" id="" placeholder="Password"></div>
                    <div class="width-5"><input type="password" name="repeat-password" id="" placeholder="Repeat Password"></div>
                </div>
                
                <div class="d-flex align-center mt-30 justify-between" >
                    <button class="text-uppercase">Register</button>
                    <span>
                        I already have account
                        <a href="/login">Login</a>
                    </span>
                </div>
                <div class="d-flex align-center justify-between mt-30">
                    <label for="Private-account" class="styled-checkbox">
                        
                        <input type="checkbox" name="" id="Private-account">
                        <span class="checkmark"></span>
                        <span>Private Account 
                            <span class="info-container">
                                <span class="info-button"><i class="fa-solid fa-circle-info"></i></span>
                                <span class="tooltip">Private accounts are not visible to other players. You can set account visibility from account settings later.</span>
                            </span>
                              
                        </span>
                    </label>
                    
                </div>
            </form>
        </section>
    </main>
        
        <%- include('../partials/footer') %>
    </div>

    <script src="./js/register.js"></script>
</body>
</html>


