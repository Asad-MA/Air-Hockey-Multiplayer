
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../styles/global-styles.css">
    <link rel="stylesheet" href="../styles/register.css">
    <script src="https://kit.fontawesome.com/192402329c.js" crossorigin="anonymous"></script>
    
    <title>Reset Password - Air Hockey</title>
</head>
<body>
    <div class="site-main bg-default d-flex direction-col">
        <%- include('../partials/header-public') %>
        <main class="site-content fill-space d-flex direction-col justify-center align-center ">
        <section class="form-container site-modal pos-relative overflow-hidden register-form">
            <div class="loader"></div>
            <form method="post">
                <input type="text" name="requestID" value="<%- id %>" hidden>
                <input type="text" name="token" value="<%- token %>" hidden>
                <h1 class="heading-lg text-center">Reset Password</h1>
                <div class="divider mb-30 mt-20"></div>
                <div class="d-grid grid-col-2 gap-10">
                    <div><input type="password" name="password" id="" placeholder="Password"></div>
                    <div><input type="password" name="repeatpassword" id="" placeholder="Repeat Password"></div>
                </div>
                
                <div class="d-flex align-center mt-30 gap-30" >
                    <button class="text-uppercase">Reset</button>
                </div>
               
            </form>
        </section>
    </main>
        
        <%- include('../partials/footer') %>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="../js/reset-password.js"></script>
</body>
</html>


