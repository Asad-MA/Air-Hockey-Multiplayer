<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/global-styles.css">
    <link rel="stylesheet" href="/styles/dashboard.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    

    <title>Leaderboards | Air Hockey Online</title>
</head>
<style>
   .table-wrap {
    display: none;
}

.table-wrap.active {
    display: block;
}

.active-tab {
    transform: scale(1.2);
}



.active-tab span{
    color: #fff !important;
}
</style>
<body>
    <%- include('../partials/header') %>

        <div class="dashboard-layout d-flex gap-20 p-20 align-start">
            <div class="ui-sidebar sidebar-left w-20per ">
                <%- include('../partials/sidebar-left') %>
            </div>

            <div class="dashboard-content w-60per md-w-80per loading p-20 d-flex direction-col gap-30  pos-relative">
                <div class="reward-header text-center p-10">
                        <h3 class="heading-md text-uppercase divider-heading">Legends of the Game</h3>
                        <p class="text-sm text-gray">Only the best make it to the top!</p>
                    </div>

                    <div class="tabs-wrapper d-flex gap-20">
                        <div class="table-tab cursor-pointer active-tab" data-tab="table-weekly">
                            <span class="text-sm text-gray">Weekly</span>
                        </div>
                        <div class="table-tab cursor-pointer" data-tab="table-monthly">
                            <span class="text-sm text-gray">Monthly</span>
                        </div>
                        <div class="table-tab cursor-pointer" data-tab="table-allTime">
                            <span class="text-sm text-gray">All Time</span>
                        </div>
                    </div>

                    <div class="table-wrap table-weekly active">
                    <table id="leaderboards-weekly">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>User Name</th>
                                    <th>Games Played</th>
                                    <th>Coins Earned</th>
                                    <th>Goal Scored</th>

                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div class="table-wrap table-monthly">
                    <table id="leaderboards-monthly">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>User Name</th>
                                    <th>Games Played</th>
                                    <th>Coins Earned</th>
                                    <th>Goal Scored</th>

                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>


                    <div class="table-wrap table-allTime">
                    <table id="leaderboards-allTime">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>User Name</th>
                                    <th>Games Played</th>
                                    <th>Coins Earned</th>
                                    <th>Goal Scored</th>

                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
            </div>

            <div class="ui-sidebar sidebar-right w-20per md-hidden">
                <%- include('../partials/leaderboards') %>
            </div>
        </div>

        <%- include('../partials/footer') %>

        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
        <script src="./js/pages/leaderboards.js"></script>
</body>
</html>