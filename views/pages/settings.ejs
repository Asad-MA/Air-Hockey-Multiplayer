<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/global-styles.css">
    <link rel="stylesheet" href="/styles/dashboard.css">
    <link rel="stylesheet" href="/styles/settings.css">
    <title>Settings | Air Hockey Online</title>
</head>

<body>
    <%- include('../partials/header') %>

        <div class="dashboard-layout d-flex gap-20 p-20">
            <div class="ui-sidebar sidebar-left w-20per ">
                <%- include('../partials/sidebar-left') %>
            </div>

            <div class="dashboard-content w-80per md-w-80per loading p-20 d-flex direction-col gap-30  pos-relative flex-grow">
                <div class="reward-header text-center p-10">
                        <h3 class="heading-md text-uppercase divider-heading">Profile Settings</h3>
                        <p class="text-sm text-gray">Fine-tune your profile, avatar, and game identity!</p>
                    </div>
                <div class="settings-wrap d-flex gap-20">
                    <div class="player-avatar pos-relative">
                        <div class="edit-avatar-wrap pos-absolute">
                            <span class="update-avatar"><i class="fa-solid fa-file-pen text-gray"></i></span>
                            <span class="remove-avatar"><i class="fa-solid fa-delete-left text-gray"></i></span>
                        </div>
                        <img src="<%= user.avatar %>" width="100%">
                    </div>
                    <div class="settings-fields">
                        <div class="setting-box d-flex align-center">
                            <i class="fa-solid fa-user text-gray"></i>
                            <input class="text-gray text-sm" type="text" name="" id="" placeholder="@username" value="<%= user.name %>" disabled autocomplete="false">
                        </div>
                        
                        <div class="setting-box d-flex align-center">
                            <i class="fa-solid fa-address-card text-gray"></i>
                            <input class="text-gray text-sm" type="text" name="" id="" placeholder="Display name" value="<%= user.displayName %>" autocomplete="false">
                        </div>
                        <div class="setting-box d-flex align-center">
                            <i class="fa-regular fa-envelope-open text-gray"></i>
                            <input class="text-gray text-sm" type="email" name="" id="" placeholder="Email address" value="<%= user.email %>" autocomplete="false">
                        </div>
                        <!-- <div class="setting-box d-flex align-center">
                           <i class="fa-regular fa-envelope-open text-gray"></i>
                            <input class="text-gray text-sm" type="text" name="" id="" placeholder="Secondary Email" value="" autocomplete="false">
                        </div> -->
                        <div class="setting-box d-flex align-center">
                           <i class="fa-solid fa-lock text-gray"></i>
                            <input type="password" placeholder="Old Password" id="oldPassword" autocomplete="false">
                        </div>
                        <div class="setting-box d-flex align-center">
                           <i class="fa-solid fa-lock text-gray"></i>
                            <input type="password" placeholder="New Password" id="newPassword" autocomplete="false">
                        </div>

                        <div class="setting-box d-flex align-center">
                           <i class="fa-solid fa-lock text-gray"></i>
                            <input type="password" placeholder="Re-enter Password" id="confirmPassword" autocomplete="false">
                        </div>
                        
                    </div>
                    
                </div>
                <button class="text-sm font-bold update-settings">Save And Update</button>
            </div>

            
        </div>

        <div class="avatars-popup">
            <div class="reward-header text-center p-10">
