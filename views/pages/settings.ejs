            <button class="text-sm font-bold update-avatar-btn mt-20">Update Avatar</button>
        </div>
        <div class="popup-overlay"></div>

        <%- include('../partials/footer') %>

        <script defer type="module" src="/js/pages/settings.js"></script>
</body>
</html>