
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./styles/global-styles.css">
    <link rel="stylesheet" href="./styles/login.css">
    <script src="https://kit.fontawesome.com/192402329c.js" crossorigin="anonymous"></script>
    
    <title>Forget Password - Air Hockey</title>
</head>
<body>
    <div class="site-main bg-default d-flex direction-col">
        <%- include('../partials/header-public') %>
        <main class="site-content fill-space d-flex direction-col justify-center align-center">
        <section class="form-container site-modal pos-relative overflow-hidden" style="width: clamp(360px, calc(100vw - 100px), 650px);">
            <div class="loader"></div>
            <form method="post">
                <h1 class="heading-lg text-center text-normal">Forgot Password?</h1>
                <p class="text-center">Enter your email so that we can send you password reset link</p>
                <div class="divider mb-30 mt-20"></div>
                <div class="d-flex direction-col gap-10">
                    <div><input type="email" name="email" id="" placeholder="Email Address"></div>
                </div>
                
                <div class="d-flex align-center mt-30 gap-30" >
                    <button class="text-uppercase">Send Email</button>
                    <span>
                        <a class="text-uppercase text-sm" href="/login">Back to Login</a>
                    </span>
                </div>
            </form>
        </section>
    </main>
        
        <%- include('../partials/footer') %>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="./js/forgot-pass.js"></script>
</body>
</html>


